<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- Sidebar menu -->
    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="match_parent"
        android:background="@color/blue_100"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center_horizontal"
            android:text="Admin Panel"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/white"
            android:alpha="0.2"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/buttonMenuProducts"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/menu_button_background"
            android:drawableStart="@drawable/ic_orders"
            android:drawablePadding="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:text="Products"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/buttonMenuCategories"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/menu_button_background"
            android:drawableStart="@drawable/ic_notifications"
            android:drawablePadding="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:text="Categories"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/buttonMenuPayments"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/menu_button_background"
            android:drawableStart="@drawable/ic_orders"
            android:drawablePadding="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:text="Payments"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/buttonMenuUsers"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/menu_button_background"
            android:drawableStart="@drawable/ic_info"
            android:drawablePadding="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:text="Users"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- Main content area -->
    <FrameLayout
        android:id="@+id/adminContentFrame"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@android:color/white"/>
</LinearLayout>